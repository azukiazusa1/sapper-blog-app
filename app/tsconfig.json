{
  "compilerOptions": {
    "module": "es2022",
    "lib": ["es2022", "DOM"],
    "target": "es2022",
    "sourceMap": true,
    "jsx": "react-jsx",
    "strict": false
  },
  "include": [
    "src/**/*.d.ts",
    "src/**/*.js",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.svelte",
    "tests/**/*.ts"
  ],
  "exclude": ["src/**/*.stories.ts"],
  "extends": "$app/tsconfig"
}
